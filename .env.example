# Resend API key for the contact form (used by the Cloudflare Pages Function).
# 1. Sign up at https://resend.com
# 2. Create an API key in the Resend dashboard
# 3. Add RESEND_API_KEY as a secret in Cloudflare Pages:
#    Workers & Pages → your project → Settings → Environment variables → Add variable
#    Name: RESEND_API_KEY, Value: re_xxxxxxxx
#    Make sure to add it for both Production and Preview if needed.

# Supabase (shared project — LingoLeaf uses the `lingoleaf` schema)
# In Vite, the `VITE_` prefix is required for client-side access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_DB_SCHEMA=lingoleaf

# Cloudflare Turnstile (Feature Forum abuse protection)
VITE_TURNSTILE_SITE_KEY=

# Server-only (set in Cloudflare Pages env, not in client .env files):
# TURNSTILE_SECRET_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Turnstile verification write only; never in VITE_* vars
# RESEND_API_KEY=

# App is served at /lingoleaf on the parent domain (see vite.config.ts base path).
